{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git commit --amend:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./evals/datasets/**)",
      "Write(./evals/datasets/**)"
    ]
  }
}
